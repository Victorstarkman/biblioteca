{
  "name": "biblioteca",
  "version": "1.0.0",
  "private": true,
  "description": "Gestión de biblioteca personal: libros, temáticas y horarios de lectura",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "db:migrate": "node --env-file=.env server/scripts/migrate.js",
    "db:seed": "node --env-file=.env server/scripts/seed.js",
    "code": "code ."
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}

{
	"mcpServers": {
		"mysqldb-mcp-server": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"mysqldb-mcp-server"
			],
			"env": {
				"MYSQL_HOST": "localhost",
				"MYSQL_USER": "root",
				"MYSQL_PASSWORD": "",
				"MYSQL_DATABASE": "biblioteca",
				"MYSQL_READONLY": "true"
			}
		}
	}
}
